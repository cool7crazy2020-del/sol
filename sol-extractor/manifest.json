{
  "manifest_version": 3,
  "name": "SOL Tapstitch Order Assistant",
  "version": "1.3.0",
  "description": "Prepare Tapstitch checkout addresses from SOL paid orders. Never submits payments.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://tapstitch.com/*",
    "https://www.tapstitch.com/*",
    "https://cool7crazy2020-del.github.io/sol/*",
    "https://shopsol.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open SOL Order Assistant"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tapstitch.com/account/products-pool/product/*",
        "https://www.tapstitch.com/account/products-pool/product/*",
        "https://tapstitch.com/order/checkout*",
        "https://www.tapstitch.com/order/checkout*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}